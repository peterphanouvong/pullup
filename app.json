{
  "expo": {
    "name": "Pull Up",
    "slug": "pullup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pullup",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.peterphanouvong.pullup",
      "userInterfaceStyle": "dark",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.peterphanouvong.pullup"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-sensors",
        {
          "motionPermission": "Pull Up tilts the session jar on your profile with your phone."
        }
      ],
      "expo-apple-authentication",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.peterphanouvong.pullup.widgets",
          "groupIdentifier": "group.com.peterphanouvong.pullup",
          "widgets": [
            {
              "name": "WeekWidget",
              "displayName": "This week",
              "description": "Sessions done this week, and what’s next.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "peterphanouvong",
    "extra": {
      "eas": {
        "projectId": "c42c7aa4-e4a0-45bf-806d-35f162220aa3"
      }
    }
  }
}
