EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx
# Google Sign-In (Google Cloud console → Credentials → OAuth client IDs).
# The iOS client signs the user in; the web client is the token audience
# Supabase checks. Leave unset to hide the Google button.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
